# Server settings
HOST=127.0.0.1
PORT=8765
RELAY_PORT=3000
PYTHON_BACKEND_URL=http://127.0.0.1:8765

# YOLO11n Model Settings
YOLO_MODEL_PATH=weights/yolo11n.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_IMGSZ=640
YOLO_DEVICE=auto
YOLO_MAX_DET=100
YOLO_CONCURRENCY_LIMIT=1
YOLO_DOWNLOAD_TIMEOUT_SECONDS=10

# Depth Anything V2 Settings
DEPTH_MODEL_NAME=depth-anything/Depth-Anything-V2-Small-hf

# Spatial & Depth thresholds (relative depth in [0, 1])
NEAR_THRESHOLD=0.66
MID_THRESHOLD=0.33
FLAT_DEPTH_EPSILON=0.02

# Direction Boundaries (proportions of frame width / height)
HORIZ_LEFT_MAX=0.33
HORIZ_RIGHT_MIN=0.67
VERT_TOP_MAX=0.33
VERT_BOTTOM_MIN=0.67

# Memory & Retention
SCENE_RETENTION_FRAMES=5
REVIEW_CACHE_TTL_SECONDS=180
UPLOAD_RETENTION_HOURS=24
DB_PATH=storage/byaku.db
